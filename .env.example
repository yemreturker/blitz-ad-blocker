# Copy this file to .env and configure your Blitz path
# On most systems, you can leave this empty and the default path will be used

# Windows default path (usually works automatically):
# BLITZ_PATH=C:\Users\YourUsername\AppData\Local\Programs\Blitz\Blitz.exe

# macOS default path (usually works automatically):
# BLITZ_PATH=/Applications/Blitz.app/Contents/MacOS/Blitz

# If the default path doesn't work, uncomment and edit the appropriate line above
